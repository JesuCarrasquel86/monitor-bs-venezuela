{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monitor-bs-vz",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  // Dominios propios. Cloudflare crea el DNS y el certificado al desplegar.
  "routes": [
    { "pattern": "bainas.app", "custom_domain": true },
    { "pattern": "app.bainas.app", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "."
  }
}
